description: Code quality standards - SOLID, DRY, clean code practices, naming, error handling, immutability. Universal across languages and frameworks.
alwaysApply: true
---
// Code Quality Standards

// SOLID Principles
// Single Responsibility
/**
 * Returns the user email.
 *
 * @param {object} user - The user object.
 * @returns {string} The user email.
 */
function getUserEmail(user) {
  return user.email;
}

// Open/Closed
class User {
  constructor(id, email) {
    this.id = id;
    this.email = email;
  }
}

class Admin extends User {
  constructor(id, email, role) {
    super(id, email);
    this.role = role;
  }
}

// Liskov Substitution
class Animal {
  sound() {
    console.log('Generic animal sound');
  }
}

class Dog extends Animal {
  sound() {
    console.log('Woof!');
  }
}

// Interface Segregation
interface UserInterface {
  getId(): number;
  getEmail(): string;
}

interface AdminInterface extends UserInterface {
  getRole(): string;
}

class UserImpl implements UserInterface {
  private id: number;
  private email: string;

  constructor(id: number, email: string) {
    this.id = id;
    this.email = email;
  }

  getId(): number {
    return this.id;
  }

  getEmail(): string {
    return this.email;
  }
}

class AdminImpl implements AdminInterface {
  private id: number;
  private email: string;
  private role: string;

  constructor(id: number, email: string, role: string) {
    this.id = id;
    this.email = email;
    this.role = role;
  }

  getId(): number {
    return this.id;
  }

  getEmail(): string {
    return this.email;
  }

  getRole(): string {
    return this.role;
  }
}

// Dependency Inversion
class Logger {
  log(message: string) {
    console.log(message);
  }
}

class LoggerImpl implements Logger {
  log(message: string) {
    console.log(message);
  }
}

// DRY
const repeat = (str: string, count: number) => {
  let result = '';
  for (let i = 0; i < count; i++) {
    result += str;
  }
  return result;
};

// Clean Code
function getUserName(user: { name: string }) {
  return user.name;
}

// Error Handling
function divide(a: number, b: number): number | string {
  if (b === 0) {
    throw new Error('Cannot divide by zero!');
  }
  return a / b;
}

// Immutability
const user = { name: 'John', age: 30 };

const updatedUser = { ...user, name: 'Jane' };

// "Engineered Enough"
function add(a: number, b: number): number {
  return a + b;
}